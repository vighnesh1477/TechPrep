    "topic": "Mixtures and Alligation",
    "difficulty": "Medium",
    "question": "In what ratio must water be mixed with milk costing Rs 20/L to get Rs 16/L?",
    "options": [
        "1:2",
        "1:3",
        "1:4",
        "1:5"
    ],
    "answer": 2,
    "explanation": "Water is Rs 0. (20-16):(16-0) = 4:16 = 1:4."
}
